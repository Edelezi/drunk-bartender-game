{
  "name": "vite-pixi-ts",
  "private": true,
  "version": "0.1.1-alpha",
  "type": "module",
  "scripts": {
    "start": "vite",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "pre-push": "tsc --noEmit",
    "lint": "biome format --write ./src",
    "dev": "vite",
    "prod": "vite build && vite preview",
    "build": "vite build",
    "preview": "vite preview",
    "tsc": "tsc --noEmit",
    "packer": "node atlaspacker.cjs"
  },
  "lint-staged": {
    "*.ts": "biome format --staged --write ./src"
  },
  "dependencies": {
    "@pixi/filter-zoom-blur": "^5.1.1",
    "pixi-spine": "4.0.4",
    "pixi.js": "7.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.1",
    "free-tex-packer-core": "^0.3.4",
    "husky": "8.0.3",
    "lint-staged": "15.2.7",
    "typescript": "5.4.2",
    "vite": "5.1.6"
  }
}
